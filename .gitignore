# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ─── Dependencies ────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Testing ─────────────────────────────────────────────────────────────────
/coverage

# ─── Next.js ─────────────────────────────────────────────────────────────────
/.next/
/out/

# ─── Production build ────────────────────────────────────────────────────────
/build

# ─── OS / editor junk ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini

# ─── Debug logs ──────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ─── Environment variables (ALL variants) ────────────────────────────────────
# .env.example is intentionally NOT ignored — it documents required variables.
.env
.env.*
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local

# ─── Firebase service account keys ───────────────────────────────────────────
# NEVER commit these — they grant full admin access to your Firebase project
*firebase-adminsdk*.json
*service-account*.json
*serviceAccount*.json
firebase-admin-*.json

# ─── Other credential / secret files ─────────────────────────────────────────
*.key
*.p12
*.pfx
secrets/
credentials/

# ─── Vercel ──────────────────────────────────────────────────────────────────
.vercel

# ─── TypeScript ──────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Generated lint / build artifacts ────────────────────────────────────────
# These are generated by running npm run lint or build — not source files.
lint.json
lint-results.txt
lint-summary.txt
tsc-out.txt
tsc-errors.txt

# ─── One-time migration / fix scripts ────────────────────────────────────────
# Throwaway scripts used during development — not part of the application.
fix-req-unknown.js
fix-unknown.ps1
fix-*.js
fix-*.ps1
fix-*.sh

# ─── Tooling caches ──────────────────────────────────────────────────────────
.code-review-graph/

# ─── AI IDE / agent tooling (personal, not project config) ───────────────────
# Claude
CLAUDE.md
.claude/

# Cursor
.cursorrules
.cursor/

# Windsurf
.windsurfrules

# Gemini CLI
GEMINI.md

# OpenCode
.opencode.json

# Generic agent instructions
AGENTS.md

# Kiro IDE
.kiro/

# MCP server configs (may contain local paths / tokens)
.mcp.json

# VSCode workspace settings (personal)
.vscode/
